# =====================================================================
# FinSync configuration - EXAMPLE FILE
# 1. Copy this file and name the copy ".env"  (in the same folder)
# 2. Fill in your own values
# 3. NEVER commit .env to GitHub (it is listed in .gitignore)
# =====================================================================

# --- Flask ------------------------------------------------------------
# Generate a random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
FLASK_DEBUG=1
# Set to 1 only when the site runs on HTTPS
SESSION_COOKIE_SECURE=0

# --- MySQL --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finsync
DB_USER=finsync_app
# Same password you used in database/01_create_database.sql
DB_PASSWORD=CHANGE_ME_Strong_Pass_123!

# --- Password reset ------------------------------------------------------
# Address used to build the link in the email (no trailing slash).
# Local: http://127.0.0.1:5000     Production: https://your-domain
APP_BASE_URL=http://127.0.0.1:5000
RESET_TOKEN_EXPIRY_MINUTES=30
RESET_MAX_REQUESTS=3
RESET_WINDOW_MINUTES=15

# --- Email ----------------------------------------------------------------
# console = print the email in the terminal (local testing only, nothing is sent)
# smtp    = really send emails using the settings below
MAIL_BACKEND=console

# Example for Gmail (needs 2-Step Verification + an App Password, see README)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_SENDER=your.address@gmail.com
