# Copy this file, name the copy ".env", and fill in your own values.
# Never upload .env to GitHub.

# Any long random text. You can make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finsync
DB_USER=finsync_app
DB_PASSWORD=CHANGE_ME_Strong_Pass_123!

# How many minutes a reset link stays valid
RESET_TOKEN_EXPIRY_MINUTES=30

# Email: "console" prints the email in the terminal, "smtp" really sends it
MAIL_BACKEND=console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
